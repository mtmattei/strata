<Application x:Class="StrataApp.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- tokens before templates: Layers.xaml resolves against Tokens.xaml -->
        <ResourceDictionary Source="ms-appx:///Strata/Themes/Tokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Strata/Themes/Layers.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
