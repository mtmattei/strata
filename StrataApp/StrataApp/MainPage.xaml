<Page
    x:Class="StrataApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strata="using:StrataApp.Strata.Controls"
    xmlns:markup="using:StrataApp.Strata.Markup"
    Background="{StaticResource Canvas.Default}">

    <ScrollViewer>
        <StackPanel Padding="34,34,34,89" Spacing="55" MaxWidth="1160" HorizontalAlignment="Center">

            <!-- masthead -->
            <StackPanel Spacing="13">
                <TextBlock Text="COMPOSITION STUDY" Style="{StaticResource StrataLabel}" />
                <TextBlock Style="{StaticResource StrataDisplay}">
                    <Run Text="A component made of " /><Run Text="other components" Foreground="{StaticResource Layer.Surface}" />
                </TextBlock>
                <TextBlock
                    Style="{StaticResource StrataBody}"
                    MaxWidth="560"
                    HorizontalAlignment="Left"
                    Text="A card built as three nested templated controls, each owning exactly one concern. Pull the stack apart and every layer accounts for itself." />
            </StackPanel>

            <!-- ══ 01 · the bench ══════════════════════════════ -->
            <StackPanel Spacing="21">
                <Grid ColumnSpacing="13" BorderBrush="{StaticResource Surface.Outline}" BorderThickness="0,0,0,1" Padding="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="01" Style="{StaticResource StrataLabel}" />
                    <TextBlock Grid.Column="1" Text="THE STACK" Style="{StaticResource StrataLabel}" Foreground="{StaticResource Text.Secondary}" />
                </Grid>

                <Grid ColumnSpacing="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <!-- specimen stage -->
                    <Border
                        Background="{StaticResource Canvas.Raised}"
                        BorderBrush="{StaticResource Surface.Outline}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Shape.Tight}"
                        MinHeight="420"
                        Padding="21">

                        <!--
                            Perspective host. Fixed size so the vanishing point stays
                            put no matter how wide the column gets; the stack rotates
                            as one body and the sheets separate along Z inside it.
                        -->
                        <Grid Width="440" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid
                                x:Name="Stack"
                                Width="300"
                                Height="180"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <!-- sheet 1 · Surface — shape, fill, elevation -->
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <MatrixTransform Matrix="{x:Bind SheetMatrix(SepSlider.Value, 0), Mode=OneWay}" />
                                    </Grid.RenderTransform>
                                    <strata:Surface
                                        x:Name="SheetSurface"
                                        Elevation="{x:Bind ToLevel(ElevSlider.Value), Mode=OneWay}" />
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,-118,0"
                                        IsHitTestVisible="False"
                                        Opacity="{x:Bind TagFade(SepSlider.Value), Mode=OneWay}">
                                        <Rectangle Width="20" Height="1" Fill="{StaticResource Layer.Surface}" Opacity="0.5" VerticalAlignment="Center" />
                                        <TextBlock Text="SURFACE" Style="{StaticResource StrataLabel}" Foreground="{StaticResource Layer.Surface}" />
                                    </StackPanel>
                                </Grid>

                                <!-- sheet 2 · StateLayer (hover / press live here) -->
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <MatrixTransform Matrix="{x:Bind SheetMatrix(SepSlider.Value, 1), Mode=OneWay}" />
                                    </Grid.RenderTransform>
                                    <strata:StateLayer
                                        x:Name="SheetState"
                                        IsInteractive="{x:Bind StateToggle.IsOn, Mode=OneWay}">
                                        <!-- the layer itself has no fill; the dashed edge is
                                             the bench drawing where its bounds actually are -->
                                        <Rectangle
                                            Stroke="{StaticResource Layer.State}"
                                            StrokeThickness="1"
                                            StrokeDashArray="4 4"
                                            RadiusX="14"
                                            RadiusY="14"
                                            Opacity="{x:Bind TagFade(SepSlider.Value), Mode=OneWay}" />
                                    </strata:StateLayer>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,-118,0"
                                        IsHitTestVisible="False"
                                        Opacity="{x:Bind TagFade(SepSlider.Value), Mode=OneWay}">
                                        <Rectangle Width="20" Height="1" Fill="{StaticResource Layer.State}" Opacity="0.5" VerticalAlignment="Center" />
                                        <TextBlock Text="STATELAYER" Style="{StaticResource StrataLabel}" Foreground="{StaticResource Layer.State}" />
                                    </StackPanel>
                                </Grid>

                                <!-- sheet 3 · Content -->
                                <Grid IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <MatrixTransform Matrix="{x:Bind SheetMatrix(SepSlider.Value, 2), Mode=OneWay}" />
                                    </Grid.RenderTransform>
                                    <StackPanel
                                        Spacing="8"
                                        Padding="21"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="BACKLOG · THEMING" Style="{StaticResource StrataLabel}" />
                                        <TextBlock Text="Ship the elevation scale" Style="{StaticResource StrataCardTitle}" />
                                        <TextBlock
                                            Style="{StaticResource StrataBody}"
                                            Text="Three tokens left to map before the theme ships." />
                                        <!--
                                            Specimen-tag footer: hairline rule, then small caps
                                            metadata. Status reads in ink, never in a layer color:
                                            blue, amber and sage are spoken for by the legend.
                                        -->
                                        <Border Height="1" Margin="0,5,0,0" Background="{StaticResource Surface.Outline}" />
                                        <StackPanel Orientation="Horizontal" Spacing="13">
                                            <TextBlock Text="IN REVIEW" Style="{StaticResource StrataLabel}" Foreground="{StaticResource Text.Secondary}" />
                                            <TextBlock Text="DUE FRI" Style="{StaticResource StrataLabel}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,-118,0"
                                        Opacity="{x:Bind TagFade(SepSlider.Value), Mode=OneWay}">
                                        <Rectangle Width="20" Height="1" Fill="{StaticResource Layer.Content}" Opacity="0.5" VerticalAlignment="Center" />
                                        <TextBlock Text="CONTENT" Style="{StaticResource StrataLabel}" Foreground="{StaticResource Layer.Content}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <TextBlock
                                Text="{x:Bind StageHint(SepSlider.Value), Mode=OneWay}"
                                Style="{StaticResource StrataLabel}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>

                    <!-- instrument column -->
                    <StackPanel Grid.Column="1" Spacing="34" VerticalAlignment="Center">

                        <StackPanel Spacing="8">
                            <TextBlock Text="SEPARATION" Style="{StaticResource StrataLabel}" />
                            <Slider x:Name="SepSlider" Minimum="0" Maximum="100" Value="0" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="ELEVATION · SURFACE ONLY" Style="{StaticResource StrataLabel}" />
                            <Slider x:Name="ElevSlider" Minimum="0" Maximum="3" Value="2" StepFrequency="1" TickFrequency="1" />
                            <TextBlock
                                Style="{StaticResource StrataBody}"
                                FontSize="11"
                                Text="{x:Bind ElevCaption(ElevSlider.Value), Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Spacing="13">
                            <TextBlock Text="STATELAYER" Style="{StaticResource StrataLabel}" />
                            <Grid ColumnSpacing="13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{StaticResource Layer.State}" RadiusX="1" RadiusY="1" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Pointer feedback" Style="{StaticResource StrataCardTitle}" FontSize="12" />
                                    <TextBlock Text="Switch off, then hover the card." Style="{StaticResource StrataBody}" FontSize="11" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StateToggle" Grid.Column="2" IsOn="True" OnContent="" OffContent="" MinWidth="0" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{StaticResource Layer.Surface}" RadiusX="1" RadiusY="1" />
                                <TextBlock Grid.Column="1" Text="Surface — shape · fill · elevation" Style="{StaticResource StrataBody}" FontSize="11" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{StaticResource Layer.State}" RadiusX="1" RadiusY="1" />
                                <TextBlock Grid.Column="1" Text="StateLayer — hover · press" Style="{StaticResource StrataBody}" FontSize="11" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{StaticResource Layer.Content}" RadiusX="1" RadiusY="1" />
                                <TextBlock Grid.Column="1" Text="Content — slots · layout" Style="{StaticResource StrataBody}" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ══ 02 · the seam ═══════════════════════════════ -->
            <StackPanel Spacing="21">
                <Grid ColumnSpacing="13" BorderBrush="{StaticResource Surface.Outline}" BorderThickness="0,0,0,1" Padding="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="02" Style="{StaticResource StrataLabel}" />
                    <TextBlock Grid.Column="1" Text="THE SEAM · TEMPLATED PROPERTIES BEAT STYLE SETTERS" Style="{StaticResource StrataLabel}" Foreground="{StaticResource Text.Secondary}" />
                </Grid>

                <TextBlock
                    Style="{StaticResource StrataBody}"
                    MaxWidth="640"
                    HorizontalAlignment="Left"
                    Text="Both grids below scope a style trying to raise elevation to 3. The left one targets Surface — but Card's template already sets Elevation on that Surface via TemplateBinding, and templated properties outrank style setters. The right one targets Card, upstream of the seam." />

                <Grid ColumnSpacing="21">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- fails: scoped Surface style, silently outranked -->
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="strata:Surface" BasedOn="{StaticResource DefaultSurfaceStyle}">
                                <Setter Property="Elevation" Value="3" />
                            </Style>
                        </Grid.Resources>
                        <strata:Card Header="Style targets Surface">
                            <strata:Card.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource StrataCardTitle}" />
                                </DataTemplate>
                            </strata:Card.HeaderTemplate>
                            <TextBlock Style="{StaticResource StrataBody}" Text="Setter never wins. The template's TemplateBinding on Elevation outranks it, so the card holds its inherited elevation of 1 — a short shadow, no lift." />
                        </strata:Card>
                    </Grid>

                    <!-- wins: scoped Card style, upstream of the TemplateBinding -->
                    <Grid Grid.Column="1">
                        <Grid.Resources>
                            <Style TargetType="strata:Card" BasedOn="{StaticResource DefaultCardStyle}">
                                <Setter Property="Elevation" Value="3" />
                            </Style>
                        </Grid.Resources>
                        <strata:Card Header="Style targets Card">
                            <strata:Card.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource StrataCardTitle}" />
                                </DataTemplate>
                            </strata:Card.HeaderTemplate>
                            <TextBlock Style="{StaticResource StrataBody}" Text="Setter lands on Card's own DP, flows through the TemplateBinding into Surface. This card lifts to elevation 3 — lighter fill, longer cast." />
                        </strata:Card>
                    </Grid>
                </Grid>
            </StackPanel>

            <!-- ══ 03 · regions ════════════════════════════════ -->
            <StackPanel Spacing="21">
                <Grid ColumnSpacing="13" BorderBrush="{StaticResource Surface.Outline}" BorderThickness="0,0,0,1" Padding="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="03" Style="{StaticResource StrataLabel}" />
                    <TextBlock Grid.Column="1" Text="IDENTICAL MARKUP · THREE LOOKS" Style="{StaticResource StrataLabel}" Foreground="{StaticResource Text.Secondary}" />
                </Grid>

                <TextBlock
                    Style="{StaticResource StrataBody}"
                    MaxWidth="640"
                    HorizontalAlignment="Left"
                    Text="The three Card declarations below are byte-for-byte identical. Each parent Grid scopes a different implicit style in its own Resources — nothing at the call site says so. The corner radius on the swatch resolves through the custom {markup:Token} extension." />

                <Grid ColumnSpacing="21">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- region A · inherited default -->
                    <StackPanel Spacing="13">
                        <TextBlock Text="REGION A · INHERITED" Style="{StaticResource StrataLabel}" />
                        <strata:Card Header="Ship the elevation scale">
                            <strata:Card.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource StrataCardTitle}" />
                                </DataTemplate>
                            </strata:Card.HeaderTemplate>
                            <StackPanel Spacing="13">
                                <Border Height="34" CornerRadius="{markup:Token Name=Shape.Tight}" Background="{StaticResource Layer.Surface}" />
                                <TextBlock Style="{StaticResource StrataBody}" Text="Same eight lines of markup." />
                            </StackPanel>
                        </strata:Card>
                    </StackPanel>

                    <!-- region B · flat + tight -->
                    <StackPanel Grid.Column="1" Spacing="13">
                        <TextBlock Text="REGION B · SCOPED STYLE" Style="{StaticResource StrataLabel}" />
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="strata:Card" BasedOn="{StaticResource FlatCardStyle}" />
                            </Grid.Resources>
                            <strata:Card Header="Ship the elevation scale">
                                <strata:Card.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource StrataCardTitle}" />
                                    </DataTemplate>
                                </strata:Card.HeaderTemplate>
                                <StackPanel Spacing="13">
                                    <Border Height="34" CornerRadius="{markup:Token Name=Shape.Tight}" Background="{StaticResource Layer.State}" />
                                    <TextBlock Style="{StaticResource StrataBody}" Text="Same eight lines of markup." />
                                </StackPanel>
                            </strata:Card>
                        </Grid>
                    </StackPanel>

                    <!-- region C · lifted + borderless -->
                    <StackPanel Grid.Column="2" Spacing="13">
                        <TextBlock Text="REGION C · SCOPED STYLE" Style="{StaticResource StrataLabel}" />
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="strata:Card" BasedOn="{StaticResource LiftedCardStyle}" />
                            </Grid.Resources>
                            <strata:Card Header="Ship the elevation scale">
                                <strata:Card.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource StrataCardTitle}" />
                                    </DataTemplate>
                                </strata:Card.HeaderTemplate>
                                <StackPanel Spacing="13">
                                    <Border Height="34" CornerRadius="{markup:Token Name=Shape.Tight}" Background="{StaticResource Layer.Content}" />
                                    <TextBlock Style="{StaticResource StrataBody}" Text="Same eight lines of markup." />
                                </StackPanel>
                            </strata:Card>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
