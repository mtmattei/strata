<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strata="using:StrataApp.Strata.Controls">

    <!--
        LAYER 1 · Surface — shape, fill, outline, elevation.

        Elevation is three coordinated moves, all driven by visual state
        setters on named template parts:
          Lift   ShapeRoot rises a few pixels (a Margin, so it survives layout)
          Tint   a light wash over the fill; higher sheets catch more light
          Cast   a gradient band under the bottom edge stands in for a penumbra

        ThemeShadow is deliberately absent: it renders nothing on the Skia
        desktop head, so an Elevation slider wired to it looks broken.
    -->
    <Style x:Key="DefaultSurfaceStyle" TargetType="strata:Surface">
        <Setter Property="Background" Value="{StaticResource Surface.Container}" />
        <Setter Property="BorderBrush" Value="{StaticResource Surface.Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Shape.Card}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="strata:Surface">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ElevationStates">
                                <VisualState x:Name="Elevation0">
                                    <VisualState.Setters>
                                        <Setter Target="ShapeRoot.Margin" Value="0" />
                                        <Setter Target="Tint.Opacity" Value="0" />
                                        <Setter Target="Cast.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Elevation1">
                                    <VisualState.Setters>
                                        <Setter Target="ShapeRoot.Margin" Value="0,-1,0,1" />
                                        <Setter Target="Tint.Opacity" Value="0.03" />
                                        <Setter Target="Cast.Opacity" Value="0.55" />
                                        <Setter Target="Cast.Height" Value="16" />
                                        <Setter Target="Cast.Margin" Value="16,0,16,-10" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Elevation2">
                                    <VisualState.Setters>
                                        <Setter Target="ShapeRoot.Margin" Value="0,-3,0,3" />
                                        <Setter Target="Tint.Opacity" Value="0.055" />
                                        <Setter Target="Cast.Opacity" Value="0.7" />
                                        <Setter Target="Cast.Height" Value="26" />
                                        <Setter Target="Cast.Margin" Value="10,0,10,-18" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Elevation3">
                                    <VisualState.Setters>
                                        <Setter Target="ShapeRoot.Margin" Value="0,-6,0,6" />
                                        <Setter Target="Tint.Opacity" Value="0.085" />
                                        <Setter Target="Cast.Opacity" Value="0.85" />
                                        <Setter Target="Cast.Height" Value="40" />
                                        <Setter Target="Cast.Margin" Value="2,0,2,-30" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border
                            x:Name="Cast"
                            VerticalAlignment="Bottom"
                            Height="16"
                            Margin="16,0,16,-10"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{StaticResource Surface.Cast}"
                            Opacity="0"
                            IsHitTestVisible="False" />

                        <Border
                            x:Name="ShapeRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid>
                                <Border
                                    x:Name="Tint"
                                    Background="{StaticResource Surface.Tint}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="strata:Surface" BasedOn="{StaticResource DefaultSurfaceStyle}" />

    <!-- LAYER 2 · StateLayer — pointer feedback overlay -->
    <Style TargetType="strata:StateLayer">
        <Setter Property="CornerRadius" Value="{StaticResource Shape.Card}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="strata:StateLayer">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Opacity" Value="0.06" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Opacity" Value="0.12" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        <Border
                            x:Name="Overlay"
                            Background="{StaticResource Surface.State}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LAYER 3 · Card — content slots; delegates shape and interaction -->
    <Style x:Key="DefaultCardStyle" TargetType="strata:Card">
        <Setter Property="CornerRadius" Value="{StaticResource Shape.Card}" />
        <Setter Property="Padding" Value="{StaticResource Space.Card}" />
        <Setter Property="Background" Value="{StaticResource Surface.Container}" />
        <Setter Property="BorderBrush" Value="{StaticResource Surface.Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="strata:Card">
                    <strata:Surface
                        Elevation="{TemplateBinding Elevation}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <strata:StateLayer
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsInteractive="{TemplateBinding IsInteractive}">
                            <Grid Padding="{TemplateBinding Padding}" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ContentPresenter
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}" />
                                <ContentPresenter
                                    Grid.Row="1"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </strata:StateLayer>
                    </strata:Surface>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- implicit alias enables BasedOn chains everywhere -->
    <Style TargetType="strata:Card" BasedOn="{StaticResource DefaultCardStyle}" />

    <Style x:Key="FlatCardStyle" TargetType="strata:Card" BasedOn="{StaticResource DefaultCardStyle}">
        <Setter Property="Elevation" Value="0" />
        <Setter Property="Background" Value="{StaticResource Surface.Sunken}" />
        <Setter Property="CornerRadius" Value="{StaticResource Shape.Tight}" />
    </Style>

    <Style x:Key="LiftedCardStyle" TargetType="strata:Card" BasedOn="{StaticResource DefaultCardStyle}">
        <Setter Property="Elevation" Value="3" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

</ResourceDictionary>
