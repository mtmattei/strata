<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        STRATA tokens. Plain root-level dictionary, StaticResource lookups.
        Dark-only by design; the demo is a fixed specimen bench.
        Layer semantics: blue = Surface, amber = StateLayer, sage = Content.
    -->

    <!-- canvas -->
    <Color x:Key="Strata.Color.Canvas">#0E1013</Color>
    <Color x:Key="Strata.Color.Raised">#16191E</Color>
    <Color x:Key="Strata.Color.Card">#1C2027</Color>
    <Color x:Key="Strata.Color.CardSunken">#12151A</Color>
    <Color x:Key="Strata.Color.Line">#262B33</Color>
    <Color x:Key="Strata.Color.Ink">#E3E6EA</Color>
    <Color x:Key="Strata.Color.InkDim">#8B939E</Color>
    <Color x:Key="Strata.Color.InkFaint">#565D68</Color>

    <!-- layer semantics -->
    <Color x:Key="Strata.Color.LayerSurface">#6E9BE8</Color>
    <Color x:Key="Strata.Color.LayerState">#D9A441</Color>
    <Color x:Key="Strata.Color.LayerContent">#8FB573</Color>
    <Color x:Key="Strata.Color.StateOverlay">#E3E6EA</Color>

    <!-- elevation: a tonal tint lightens the fill as the sheet rises -->
    <Color x:Key="Strata.Color.Tint">#C6D6F0</Color>

    <SolidColorBrush x:Key="Canvas.Default" Color="{StaticResource Strata.Color.Canvas}" />
    <SolidColorBrush x:Key="Canvas.Raised" Color="{StaticResource Strata.Color.Raised}" />
    <SolidColorBrush x:Key="Surface.Container" Color="{StaticResource Strata.Color.Card}" />
    <SolidColorBrush x:Key="Surface.Sunken" Color="{StaticResource Strata.Color.CardSunken}" />
    <SolidColorBrush x:Key="Surface.Outline" Color="{StaticResource Strata.Color.Line}" />
    <SolidColorBrush x:Key="Surface.State" Color="{StaticResource Strata.Color.StateOverlay}" />
    <SolidColorBrush x:Key="Surface.Tint" Color="{StaticResource Strata.Color.Tint}" />
    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Strata.Color.Ink}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Strata.Color.InkDim}" />
    <SolidColorBrush x:Key="Text.Faint" Color="{StaticResource Strata.Color.InkFaint}" />
    <SolidColorBrush x:Key="Layer.Surface" Color="{StaticResource Strata.Color.LayerSurface}" />
    <SolidColorBrush x:Key="Layer.State" Color="{StaticResource Strata.Color.LayerState}" />
    <SolidColorBrush x:Key="Layer.Content" Color="{StaticResource Strata.Color.LayerContent}" />

    <!--
        Cast shadow. Plain XAML on the Skia stack has no blur primitive, so the
        penumbra is a gradient band anchored under the bottom edge: the opaque
        end tucks behind the sheet, the transparent end fades into the canvas.
    -->
    <LinearGradientBrush x:Key="Surface.Cast" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="#A6000000" />
        <GradientStop Offset="0.45" Color="#59000000" />
        <GradientStop Offset="1" Color="#00000000" />
    </LinearGradientBrush>

    <!-- shape and spacing (fibonacci) -->
    <CornerRadius x:Key="Shape.Card">14</CornerRadius>
    <CornerRadius x:Key="Shape.Tight">6</CornerRadius>
    <Thickness x:Key="Space.Card">21</Thickness>
    <x:Double x:Key="Space.1">8</x:Double>
    <x:Double x:Key="Space.2">13</x:Double>
    <x:Double x:Key="Space.3">21</x:Double>
    <x:Double x:Key="Space.4">34</x:Double>
    <x:Double x:Key="Space.5">55</x:Double>

    <!--
        Type. Defaults for now. Drop MartianMono-Regular.ttf and
        Newsreader-Light.ttf into Assets/Fonts and repoint these two
        resources for the full Super Normal treatment.
    -->
    <FontFamily x:Key="Font.Utility">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI</FontFamily>

    <Style x:Key="StrataDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="42" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StrataLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Utility}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="Foreground" Value="{StaticResource Text.Faint}" />
    </Style>

    <Style x:Key="StrataBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Utility}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="StrataCardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Utility}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    </Style>

    <!--
        Instrument chrome. Lightweight styling only: overriding the stock WinUI
        brush keys pulls Slider and ToggleSwitch onto the Strata palette with no
        retemplating. The toggle reads amber because it drives the StateLayer,
        which is the amber layer in the legend.
    -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource Strata.Color.Line}" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{StaticResource Strata.Color.Line}" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{StaticResource Strata.Color.Line}" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource Strata.Color.InkFaint}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource Strata.Color.InkDim}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource Strata.Color.InkDim}" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource Strata.Color.Ink}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource Strata.Color.Ink}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource Strata.Color.Ink}" />
    <SolidColorBrush x:Key="SliderInnerThumbBackground" Color="{StaticResource Strata.Color.Ink}" />
    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="{StaticResource Strata.Color.Canvas}" />
    <SolidColorBrush x:Key="SliderTickBarFill" Color="{StaticResource Strata.Color.Line}" />

    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource Strata.Color.LayerState}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource Strata.Color.LayerState}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource Strata.Color.LayerState}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource Strata.Color.LayerState}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource Strata.Color.LayerState}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource Strata.Color.Canvas}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{StaticResource Strata.Color.Canvas}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource Strata.Color.InkFaint}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{StaticResource Strata.Color.InkDim}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{StaticResource Strata.Color.InkDim}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{StaticResource Strata.Color.Ink}" />

</ResourceDictionary>
